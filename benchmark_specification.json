  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --kernel-type all --dtype fp16 --input-shape 1,3,32,32 --M 64 --N 64 --K 64 --batch-size 1 --prompt-source synthetic --warmup-iters 2 --num-iterations 5 --seed 42"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --kernel-type all --dtype fp16 --input-shape 1,3,224,224 --M 4096 --N 4096 --K 4096 --batch-size 8 --prompt-source synthetic --warmup-iters 10 --num-iterations 556000 --seed 42"
  },
  {
