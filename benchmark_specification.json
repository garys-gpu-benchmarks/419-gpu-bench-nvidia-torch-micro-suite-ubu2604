  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure local PyTorch GEMM and Conv2D microkernel latency/TFLOPS"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates CUDA GEMM and Conv2D microkernel metrics from gemm.py and conv2d.py"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: GEMM execution time, us (gemm_time_usec); #2: GEMM throughput, TFLOPS (gemm_tflops); #3: GEMM minimum traffic, GB/s (gemm_bandwidth_gb_s); #4: Conv2d execution time, us (conv_time_usec); #5: Conv2d throughput, TFLOPS (conv_tflops); #6: Conv2d minimum traffic, GB/s (conv_bandwidth_gb_s)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run scripts/gemm.py and scripts/conv2d.py via collect_torch_micro.py. Official TorchBench runners are not executed"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run local scripts/gemm.py for GEMM (C = A x B) and scripts/conv2d.py for Conv2d on yaml M/N/K and input_shape, parse RESULT time/TFLOPS/bandwidth, and write gemm, conv2d, and summary CSV rows, to measure PyTorch CUDA microkernel performance. This is not TorchBench run.py"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run local scripts/gemm.py for GEMM and scripts/conv2d.py for Conv2d on yaml M, N, K and input_shape, parse RESULT time, TFLOPS, and bandwidth, and write gemm, conv2d, and summary rows. This is not TorchBench run.py"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Runs local scripts/gemm.py and scripts/conv2d.py (PyTorch CUDA), not a TorchBench package and not ROCm. device_id, dtype (fp16), M/N/K, input_shape / image size, batch_size, warmup_iters, num_iterations, and seed come from yaml. kernel_type selects which script; the collector always runs both and writes gemm, conv2d, and summary rows"
  },
  {
